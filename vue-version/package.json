{
  "name": "markdown-reader-vue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scan-files.js && vite build && node -e \"import('fs').then(({default:fs})=>{fs.copyFileSync('file-list.json','dist/file-list.json');fs.cpSync('biji','dist/biji',{recursive:true});})\"",
